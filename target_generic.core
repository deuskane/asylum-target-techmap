CAPI=2:

#-----------------------------------------------------------------------------
# Title      : 
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : target_generic.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: Inferred Technology Cells
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2025-01-06  1.0.0    mrosiere Created
# 2025-08-11  1.1.0    mrosiere Add cbufg
# 2025-09-06  1.1.1    mrosiere Add package
# 2026-08-02  1.1.2    mrosiere Add iobuf
# 2026-08-24  1.1.3    mrosiere Add ibuf and obuf
# 2026-09-19  1.1.4    mrosiere Move package from generic to common
# 2026-10-05  1.1.5    mrosiere Add UVVM testbench tb_techmap (sim_techmap)
#                               Rename lint target to lint_generic
#                               ibuf : drive 'Z' on buf_io
#-----------------------------------------------------------------------------

name        : asylum:target:generic:1.1.5
description : Inferred Technology Cells

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files:
      - hdl/common/techmap_pkg.vhd
      - hdl/generic/cbufg.vhd
      - hdl/generic/cgate.vhd
      - hdl/generic/sync2dff.vhd
      - hdl/generic/sync2dffrn.vhd
      - hdl/generic/iobuf.vhd
      - hdl/generic/obuf.vhd
      - hdl/generic/ibuf.vhd
    file_type    : vhdlSource
    logical_name : asylum

  #---------------------------------------
  sim:
  #---------------------------------------
    files:
      - sim/src/tb_dummy.vhd
    file_type : vhdlSource

  #---------------------------------------
  sim_uvvm:
  #---------------------------------------
    files:
      - sim/src/tb_techmap.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/techmap_wrapper.vhd
    file_type    : vhdlSource
    logical_name : asylum

  #---------------------------------------
  # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*) of
  # asylum:utils:generators, not in lint_ghdl : the dependencies of
  # generators (fifo, ram, pkg) are VHDL-2008, lint_ghdl checks the cells
  # in VHDL-93
  #---------------------------------------
  syn_ghdl:
    depend       :
      - ">=asylum:utils:generators:2.8.0"

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target (DON'T RUN)
    filesets        :
      - hdl
    default_tool    : ghdl

  #---------------------------------------
  lint_generic: &lint_generic
  #---------------------------------------
    << : *default
    description     : Lint (elaboration of every generic cell)
    default_tool    : ghdl
    toplevel        : tb_dummy
    filesets_append :
      - sim
    tools :
      ghdl :
        analyze_options : ["-fsynopsys"]

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of techmap_wrapper)
    toplevel        : asylum.techmap_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of techmap_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:generators) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_no_cgate : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of techmap_wrapper, without cgate
    filesets_append : [syn, syn_ghdl]
    parameters      :
      - WITH_CGATE=false
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_no_cgate_inverted :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of techmap_wrapper, without cgate, I/O buffer generics at 1
    parameters      :
      - WITH_CGATE=false
      - INPUT_VALUE_DISABLED=1
      - INVERT_D_I=1
      - INVERT_D_O=1
      - INVERT_OE_I=1
      - INVERT_IE_I=1

  #---------------------------------------
  # cgate latches its clock enable by design : every cell, ghdl --synth
  # with --latches (GHDL_SYNTH_OPTIONS added by ghdl_synth_latches)
  #---------------------------------------
  lint_ghdl_synth_cgate_latch :
    << : *lint_ghdl
    description     : Synthesis check of techmap_wrapper, every cell, latches allowed (cgate)
    filesets_append : [syn, syn_ghdl]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth, ghdl_synth_latches]

  #---------------------------------------
  sim_techmap:
  #---------------------------------------
    << : *default
    description     : Self-checking UVVM testbench of the generic cells
    toplevel        : tb_techmap
    filesets_append :
      - sim_uvvm
    tools :
      ghdl :
        analyze_options : ["-Wall","-frelaxed"]

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_cgate_latch : ghdl --synth --latches
  #---------------------------------------
  ghdl_synth_latches :
    cmd : [sh, -c, "echo GHDL_SYNTH_OPTIONS=--latches >> Makefile"]

#=========================================
parameters :
#=========================================

  #---------------------------------------
  # Generics of techmap_wrapper (lint_ghdl_synth_*)
  #---------------------------------------
  WITH_CGATE :
    description : true, cgate instantiated (it latches its clock enable)
    datatype    : bool
    default     : true
    paramtype   : generic

  INPUT_VALUE_DISABLED :
    description : I/O buffers, input value when disabled (0 / 1)
    datatype    : int
    default     : 0
    paramtype   : generic

  INVERT_D_I :
    description : I/O buffers, invert d_i (0 / 1)
    datatype    : int
    default     : 0
    paramtype   : generic

  INVERT_D_O :
    description : I/O buffers, invert d_o (0 / 1)
    datatype    : int
    default     : 0
    paramtype   : generic

  INVERT_OE_I :
    description : I/O buffers, invert oe_i (0 / 1)
    datatype    : int
    default     : 0
    paramtype   : generic

  INVERT_IE_I :
    description : I/O buffers, invert ie_i (0 / 1)
    datatype    : int
    default     : 0
    paramtype   : generic
